NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key
# Server-only: required by verified Razorpay order and webhook handlers.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Razorpay credentials. Never prefix these with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Server-only PayPal Sandbox credentials for OUTS Rent. Never expose the secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Manual demo conversion quote: INR per USD. Set only after checking a current rate.
PAYPAL_INR_PER_USD=
# Optional server-side OpenAI key for grounded assistant explanations.
OPENAI_API_KEY=
